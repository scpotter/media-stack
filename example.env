# Template for host_config.env — copy this file to host_config.env
# (gitignored, never committed) and fill in real values for your host.
#
# This repo's public interface: launch.sh sources ./host_config.env for
# structural config (this box's UID/GID, filesystem layout — not secrets)
# and pulls true secrets (ProtonVPN, Plex claim) from Infisical separately.
# Where host_config.env's values actually come from is entirely up to you
# — hardcode them here directly, or (as this operator does) generate this
# file from a private config store on your own infrastructure. This repo
# doesn't need to know or care which.
#
# TZ is deliberately not here — it has its own inline default
# (${TZ:-America/New_York}) directly in media.compose.yaml. If you want a
# different timezone, either edit that default or drop a plain .env file
# in this directory with TZ=Your/Zone — that's Docker Compose's own native
# auto-load mechanism, unrelated to this file.

PUID=1000
PGID=1000
DATA_ROOT=/opt/docker/data
MEDIA_ROOT=/mnt/media

# Self-hosted Infisical instance this launch.sh pulls secrets from, plus
# the project ID (UUID) each of the secret paths below lives in — find
# these under Project Settings -> General in your Infisical UI, or via
# `infisical init` if the UI doesn't expose it cleanly.
INFISICAL_API_URL=https://your-infisical-instance
CONNECTIVITY_PROJECT_ID=your-connectivity-project-id
MEDIA_ACCOUNTS_PROJECT_ID=your-media-accounts-project-id
MEDIA_SELFHOSTED_PROJECT_ID=your-media-selfhosted-project-id
